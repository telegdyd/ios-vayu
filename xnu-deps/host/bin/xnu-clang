#!/bin/bash
# clang wrapper for cross-building XNU on Linux:
#  - forces an Apple Mach-O target (stock Linux clang defaults to ELF)
#  - drops flags only Apple's clang understands
#  - links with the cctools ld64
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
args=()
# clang 14/15 require the gate below for -ftrivial-auto-var-init=zero; clang 16 made it optional and
# clang 18 removed it (an unknown argument there): keep it only for clang < 16.
major=$(/usr/bin/$drv -dumpversion 2>/dev/null); major=${major%%.*}
for a in "$@"; do
  case "$a" in
    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang)
      [ "${major:-14}" -lt 16 ] && args+=("$a");;
    -fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
    -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
    *) args+=("$a");;
  esac
done
# clang 16 made these errors by default; clang 14 (the author's) only warns, and the tree relies on that
# (vayu_* drivers call kernel functions without their prototypes). Keep clang 14's behaviour.
if [ "${major:-14}" -ge 16 ]; then
  extra+=(-Wno-error=implicit-function-declaration -Wno-error=implicit-int -Wno-error=int-conversion
          -Wno-error=incompatible-function-pointer-types)
fi
# The build runs with -w. XNU_CLANG_DIAG=1 shows just the diagnostics that hide real bugs on arm64
# (an undeclared function returns a 32-bit int: a pointer or 64-bit result loses its top half).
if [ -n "$XNU_CLANG_DIAG" ]; then
  quiet=(-Wno-everything -Wimplicit-function-declaration -Wimplicit-int -Wint-conversion
         -Wincompatible-function-pointer-types -Wint-to-pointer-cast -Wpointer-to-int-cast)
else
  quiet=(-w)
fi
exec /usr/bin/$drv -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
  "${quiet[@]}" "${extra[@]}" "${args[@]}"
